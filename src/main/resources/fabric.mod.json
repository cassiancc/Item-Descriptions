{
  "schemaVersion": 1,
  "id": "item_descriptions",
  "version": "${version}",
  "name": "Item Descriptions",
  "description": "This mod adds unique descriptions for all blocks, items, enchantments, effects, and mobs - built in a way that makes it easy to add modded content.",
  "authors": [
    "cassiancc"
  ],
  "contributors": [
    "sisby-folk",
    "MerchantCalico"
  ],
  "contact": {
    "repo": "https://github.com/cassiancc/Item-Descriptions",
    "issues": "https://github.com/cassiancc/Item-Descriptions/issues",
    "homepage": "https://moddedmc.wiki/en/project/item-descriptions/",
    "sources": "https://github.com/cassiancc/Item-Descriptions"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/item-descriptions/",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/item-descriptions"
      }
    }
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "mixins": ["item_descriptions.mixins.json"],
  "entrypoints": {
    "client": [
      "cc.cassian.item_descriptions.client.fabric.ItemDescriptionsFabricClient"
    ],
    "modmenu": [
      "cc.cassian.item_descriptions.client.config.fabric.ModMenuIntegration"
    ],
    "jade": [
      "cc.cassian.item_descriptions.client.jade.JadeIntegration"
    ],
    "limelight": [
      "cc.cassian.item_descriptions.client.limelight.LimelightIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.7",
    "minecraft": "${minecraft}",
    "fabric-item-api-v1": "*",
    "fabric-lifecycle-events-v1": "*"
  },
  "recommends": {
    "cloth-config": "*",
    "modmenu": "*"
  },
  "suggests": {
    "jade": "*"
  }
}